# Fenwick Analytics: n8n deploy env
# NOTE: yes this is in git. OPS-731 follow-up is to move it to secrets.
# (Lab note: every .env in this repo is committed on purpose, see README.md.
#  Do not copy that habit into a real deployment.)

# --- PostgreSQL ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n-lab-password
POSTGRES_DB=n8n
# POSTGRES_PASSWORD=changeme   <- initial value from the migration runbook

# --- n8n ---
N8N_ENCRYPTION_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f90

# --- owner login (no signup wizard on this instance) ---
N8N_OWNER_EMAIL=owner@example.com
# bcrypt hash of DockerLab2026. Keep the single quotes: Compose eats the $ signs
# in an unquoted value and the hash arrives truncated.
N8N_OWNER_PASSWORD_HASH='$2a$10$4v9JUCUfjGW4EtaNflZJq.yzr/v48SKstzMg9dGNJjMhmRSQs9Az6'
