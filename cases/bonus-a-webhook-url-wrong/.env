# brightline-payments: n8n environment
#
# Committed on purpose: this is a lab. In real life a .env holding a database
# password does not go into git. See the note in the repo README.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n-lab-password
POSTGRES_DB=n8n

# --- n8n ---------------------------------------------------------------------
N8N_ENCRYPTION_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f90
# N8N_LOG_LEVEL=debug        # left over from the SUP-5102 investigation

# --- login (no signup wizard on this instance) -------------------------------
N8N_OWNER_EMAIL=owner@example.com
# bcrypt of DockerLab2026. The single quotes are load-bearing: Compose
# interpolates bare $ sequences and a bcrypt hash is full of them.
N8N_OWNER_PASSWORD_HASH='$2a$10$4v9JUCUfjGW4EtaNflZJq.yzr/v48SKstzMg9dGNJjMhmRSQs9Az6'
