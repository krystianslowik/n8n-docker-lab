# Committed on purpose. Throwaway lab credentials, worth nothing outside this
# repo. In real life a .env holding a database password never goes into git.

# --- PostgreSQL ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n-lab-password
POSTGRES_DB=n8n

# --- n8n ---
N8N_ENCRYPTION_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f90

# --- Pre-provisioned owner: log in with these, there is no signup wizard ---
N8N_OWNER_EMAIL=owner@example.com
# bcrypt hash of the password DockerLab2026. The single quotes are
# load-bearing: Compose interpolates $VAR inside unquoted .env values, and a
# bcrypt hash is full of `$`.
N8N_OWNER_PASSWORD_HASH='$2a$10$4v9JUCUfjGW4EtaNflZJq.yzr/v48SKstzMg9dGNJjMhmRSQs9Az6'
