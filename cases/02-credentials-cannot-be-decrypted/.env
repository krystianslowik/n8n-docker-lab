# Acme Interiors - n8n stack env
# Rewritten during the 2026-07 move to the new host. Old file had a load of
# dead variables in it, this one is only what we actually use.

POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n-lab-password
POSTGRES_DB=n8n

# N8N_HOST=n8n.acme-interiors.example    # handled on the proxy now
N8N_ENCRYPTION_KEY=f0e1d2c3b4a5968778695a4b3c2d1e0f
GENERIC_TIMEZONE=Europe/Berlin

# Login for the instance owner: owner@example.com / DockerLab2026
N8N_OWNER_EMAIL=owner@example.com
# Leave the single quotes alone. Compose eats the $ in a bcrypt hash otherwise
# and then nobody can log in.
N8N_OWNER_PASSWORD_HASH='$2a$10$4v9JUCUfjGW4EtaNflZJq.yzr/v48SKstzMg9dGNJjMhmRSQs9Az6'
