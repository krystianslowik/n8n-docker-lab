[
  {
    "id": "qmLabOrderIntake",
    "name": "Order intake",
    "active": true,
    "settings": { "executionOrder": "v1" },
    "nodes": [
      {
        "id": "6f1c1d1e-0b1a-4c55-9d7e-1a2b3c4d5e01",
        "name": "Manual test",
        "type": "n8n-nodes-base.manualTrigger",
        "typeVersion": 1,
        "position": [0, 0],
        "parameters": {}
      },
      {
        "id": "6f1c1d1e-0b1a-4c55-9d7e-1a2b3c4d5e02",
        "name": "Order webhook",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [0, 200],
        "webhookId": "3d6f0f5e-7a55-4c1e-9d0e-5b1f0c2a9e11",
        "parameters": {
          "httpMethod": "POST",
          "path": "orders",
          "responseMode": "onReceived",
          "options": {}
        }
      },
      {
        "id": "6f1c1d1e-0b1a-4c55-9d7e-1a2b3c4d5e03",
        "name": "Send to fulfilment",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [260, 100],
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 1000,
        "parameters": {
          "method": "POST",
          "url": "http://fulfilment-api:8080/orders",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ order: $json.body?.order ?? 'manual-test', mode: $execution.mode }) }}",
          "options": {}
        },
        "credentials": {
          "httpHeaderAuth": { "id": "qmLabFulfilKey01", "name": "Fulfilment API key" }
        }
      }
    ],
    "connections": {
      "Manual test": { "main": [[{ "node": "Send to fulfilment", "type": "main", "index": 0 }]] },
      "Order webhook": { "main": [[{ "node": "Send to fulfilment", "type": "main", "index": 0 }]] }
    },
    "pinData": {}
  }
]
