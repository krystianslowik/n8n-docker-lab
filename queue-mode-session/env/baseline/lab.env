# Compose interpolation values for the queue-mode lab. Throwaway lab
# credentials, same reasoning as ../reference/.env: nothing here protects
# anything outside this directory.

# --- PostgreSQL ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=qm-lab-password
POSTGRES_DB=n8n

# --- Pre-provisioned owner (log in with owner@example.com / DockerLab2026) ---
N8N_OWNER_EMAIL=owner@example.com
# Single quotes are load-bearing: Compose would interpolate the $ sequences.
N8N_OWNER_PASSWORD_HASH='$2a$10$4v9JUCUfjGW4EtaNflZJq.yzr/v48SKstzMg9dGNJjMhmRSQs9Az6'

# --- Worker fleet ---
WORKER_REPLICAS=2
# Fallback only. N8N_CONCURRENCY_PRODUCTION_LIMIT in env/worker.env wins if set.
WORKER_CONCURRENCY_FLAG=5

# --- Downstream fulfilment API ---
FULFILMENT_API_KEY=lab-fulfilment-key-2026
# Requests it will work on at once. Request number 11 gets HTTP 429.
FULFILMENT_CAPACITY=10
FULFILMENT_LATENCY_MS=300

# --- Host ports (reference owns 5678, the break/fix cases own 5601-5611) ---
MAIN_PORT=5690
CONSOLE_PORT=5691
FULFILMENT_PORT=5692
